# ---------- Backend (read by backend/config.py; export in your shell or use a .env loader) ----------
# SQLite file (created automatically on first start)
SOA_DB_PATH=backend/database/soa.db
# Comma-separated origins allowed to call the API directly
SOA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
SOA_DEMO_OPERATOR=OP1007
SOA_DEMO_MACHINE=EXC-204
# Task progress runs this many times faster than real time in the demo
SOA_DEMO_TIME_SCALE=30
SOA_SITE_NAME=Riverside Interchange

# ---------- Frontend (copy to frontend/.env) ----------
# Where `npm run dev` / `npm run preview` proxy /api to
VITE_API_URL=http://localhost:8000
# Optional: call the API directly instead of through the proxy (needs CORS above)
# VITE_API_BASE=http://localhost:8000
